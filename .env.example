# Google Gemini API key
GEMINI_API_KEY=your_key_here

# Database Connection string (e.g. duckdb:///clara.db or postgresql://user:pass@host:port/dbname)
DATABASE_URL=duckdb:///clara.db

# Synthetic generator parameters (optional overrides)
SYNTHETIC_INSTANCE_COUNT=300
SYNTHETIC_DAYS_OF_METRICS=90
RANDOM_SEED=42
