# Example Environment Configuration for CLARA
# Copy this file to .env and insert your personal API credentials.
# Do not commit .env to version control.

# Google Gemini API Key (Required for live GenAI recommendations)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Application Configuration
DUCKDB_PATH=clara.db
LOG_LEVEL=INFO
